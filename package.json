{
  "name": "leeer-monorepo",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter @leeer/frontend dev",
    "dev:api": "pnpm --filter @leeer/api dev",
    "build:frontend": "pnpm --filter @leeer/frontend build",
    "build:api": "pnpm --filter @leeer/api build",
    "test:frontend": "pnpm --filter @leeer/frontend test",
    "test:api": "pnpm --filter @leeer/api test",
    "lint:api": "pnpm --filter @leeer/api lint"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild",
      "@nestjs/core",
      "vue-demi"
    ]
  },
  "dependencies": {
    "@juliusbrussee/caveman-code": "^0.65.2"
  }
}
